{
  "name": "foundation-libsass-template",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/zurb/foundation-libsass-template.git"
  },
  "scripts": {
    "build": "grunt build",
    "watch": "grunt watch",
    "serve": "http-server . -p 8000 -c-1",
    "dev": "grunt build && concurrently -k -n sass,web \"grunt watch\" \"npm run serve\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "grunt": "^1.6.1",
    "grunt-contrib-watch": "^1.1.0",
    "grunt-sass": "^3.1.0",
    "http-server": "^14.1.1",
    "sass": "^1.71.1"
  }
}
